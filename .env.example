# Copy this file to ".env" and fill in real values. ".env" is git-ignored.

# GitHub token (only needed for pushing from scripts)
GITHUB_TOKEN=your_github_token_here

# ---------------------------------------------------------------------------
# Telegram fraud-alert notifications
# ---------------------------------------------------------------------------
# 1. In Telegram, open @BotFather -> send /newbot -> choose a name + username.
#    BotFather replies with a bot token like 123456789:AAE-xxxxxxxxxxxxxxxxx
# 2. Open a chat with your new bot and press Start (so it may message you).
# 3. Get your numeric chat id: message @userinfobot, or visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
# 4. Paste both values below.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
